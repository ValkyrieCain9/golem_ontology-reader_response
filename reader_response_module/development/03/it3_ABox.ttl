rd:ao3Fanfic a lrmoo:F2_Expression ;
    schema1:text "It's been eight years since the war ended, and since Aang and Katara decided not to pursue a relationship. But when Aang drops into the Southern Water Tribe to visit, he finds Katara betrothed to someone else. And that just won't do." ;
    schema1:title "Forever girl" ;
    r:encoded_by rd:ao3Fanfic_Post .

