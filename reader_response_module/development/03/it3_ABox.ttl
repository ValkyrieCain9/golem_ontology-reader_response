rd:GRClause5 a r:Discourse_Act ;
    crm:P148i_is_component_of rd:GoodReadsReview ;
    crm:P2_has_type r:Evaluation ;
    crm:P67_refers_to rd:Orikan_and_Trazyn ;
    schema1:text "The scenes in which they converse are by far the most compelling, and I think I was a little disappointed that we didn't get more of them (despite them taking up perhaps half of the novel)." ;
