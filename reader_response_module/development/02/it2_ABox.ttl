rd:comment_expression_1 a lrmoo:F2_Expression ;
    crm:P105_right_held_by rd:r_u4 ;
    crm:P130i_features_are_also_found_on rd:r_c4 ;
    crm:P190_has_symbolic_content "Agreed. These sorts of sudden tone-shifts to make an impactful finale for an otherwise light-hearted SoL anime are way overdone and are just not what I'm watching for." .

rd:comment_expression_2 a lrmoo:F2_Expression ;
    crm:P105_right_held_by rd:ao3_u1 ;
