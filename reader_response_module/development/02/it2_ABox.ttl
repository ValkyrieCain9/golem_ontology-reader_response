    crm:P190_has_symbolic_content "The buffet of writers logic 🥹" .

rd:post_expression_1 a lrmoo:F2_Expression ;
    crm:P105_right_held_by rd:r_u1 ;
    crm:P130i_features_are_also_found_on rd:r_p1 ;
    crm:P190_has_symbolic_content "Hi! Welcome to another edition of the weekly Thursday Anime Discussion Thread, featuring us, the r/anime Writing Club. We simulwatch anime TV series and movies together once a month, so check us out if you'd like to participate. Our thoughts on the series, as always, are covered below. :)..." .

rd:post_expression_2 a lrmoo:F2_Expression ;
    crm:P105_right_held_by rd:ao3_u1 ;
    crm:P130i_features_are_also_found_on rd:ao3_p2 ;
    crm:P190_has_symbolic_content "Hi guys, wow. I'm bringing this story back, its been awhile I know, but i asked if someone wanted me to finish it and they said yes!" .

